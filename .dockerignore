# Dependencies / build output rebuilt inside the image
node_modules
.next
out
dist
build
coverage
*.tsbuildinfo

# VCS + editor state
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.DS_Store

# Local envs — must NEVER land in the image; pass at runtime
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Logs and diagnostic dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docs / repo meta not needed in the runtime image (README kept for parity
# with common Docker Hub conventions, no functional impact)
CONTRIBUTING.md
CHANGELOG.md
LICENSE
AGENTS.md
CLAUDE.md
docs
public/screenshots/*.psd

# Local scratch / one-off tooling
scripts
Downloads

# Test suite and its config — dev-only, not needed for `next build` / runtime.
# Excluding them keeps the build stage from typechecking vitest.config.ts (which
# imports vitest, a devDependency not installed in the runtime image).
tests
vitest.config.ts
