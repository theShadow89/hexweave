# Hexweave agent configuration.
# Copy to .env.local, edit, and restart `npm run dev` to apply.

# Master switch for the agent feature. When off (default) the agent panel is
# hidden in the UI and /api/agent returns 404. No provider config is read.
# Accepts: 1, true, yes, on (case-insensitive). Anything else => disabled.
AGENT_ENABLED=false

# Provider chosen at startup: "anthropic" (default) or "openai_compatible".
AGENT_PROVIDER=anthropic

# --- Anthropic (cloud) -------------------------------------------------------
# Required when AGENT_PROVIDER=anthropic. Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Local / OpenAI-compatible ----------------------------------------------
# Required when AGENT_PROVIDER=openai_compatible.
# Examples:
#   Ollama        : http://localhost:11434/v1  + llama3.1:8b
#   LM Studio     : http://localhost:1234/v1   + your local model name
#   llama.cpp     : http://localhost:8080/v1   + your model
#   vLLM          : http://localhost:8000/v1   + the served model id
#   Groq          : https://api.groq.com/openai/v1 + llama-3.1-70b-versatile (needs AGENT_API_KEY)
# Model must support OpenAI-style tool calling (Llama 3.1+, Qwen 2.5+, Mistral Nemo, ...).
# AGENT_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=llama3.1:8b
# AGENT_API_KEY=
